# Server Configuration
PORT=8080
ENV=production

# Database Configuration
# REQUIRED: The URI to connect to the database
DB_URI=sqlite://aircover.db

# Authentication Configuration
# Email address for the master admin user (created on boot)
MASTER_EMAIL=admin@example.com
SENDGRID_API_KEY=
FROM_EMAIL=noreply@aircover.com


# Spinitron Proxy Configuration
# REQUIRED: Base URL for Spinitron-compatible API routes (for example, your proxy)
SPINITRON_API_URL=https://spinitron.com/api
