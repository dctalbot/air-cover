package ui

templ Unauthenticated(submitted bool) {
	@Layout("Air Cover Login") {
		<h1>Air Cover</h1>
		<p>Enter your account email address to receive a login link.</p>
		if submitted {
			<p id="message" role="status">
				<strong>If an account exists, an email has been sent.</strong>
			</p>
		}
		<form id="magic-link-form" action="/auth/login" method="POST">
			<label for="email">Email</label>
			<input type="email" id="email" name="email" required/>
			<button type="submit">Submit</button>
		</form>
	}
}
