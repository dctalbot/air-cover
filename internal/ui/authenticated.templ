package ui

import (
	"strconv"
	"air-cover/internal/spinitron"
)

templ Authenticated(shows []spinitron.Show, email string, subRequests []SubRequestView, isAdmin bool) {
	@Layout("Air Cover") {
		@BaseStyles()
		@TableStyles()
		@PageHeader("Welcome to Air Cover") {
			if isAdmin {
				<a href="/admin">Admin</a>
			}
			@UserMenu(email)
		}
		<form action="/sub-requests" method="POST">
		  <label for="show-select">Show</label>
		  <select id="show-select" name="show" required>
			if len(shows) == 0 {
				<option value="">No shows available</option>
			} else {
				<option value="">Select a show</option>
			for _, show := range shows {
				<option value={ show.ID }>
				  if show.Title != "" {
					{ show.Title }
				  } else {
					{ show.ID }
				  }
				</option>
			}
			}
		  </select>
		  <br/>
		  <label for="start-time">Start Time (station time zone)</label>
		  <input type="datetime-local" id="start-time" name="start_time" required/>
		  <br/>
		  <label for="end-time">End Time (station time zone)</label>
		  <input type="datetime-local" id="end-time" name="end_time" required/>
		  <br/>
		  <blockquote id="blockquote-preview">
			<p>
			  <b>{ email }</b> is requesting a sub<span id="selected-show"></span><span id="preview-date"></span><span id="total-duration"></span>
			</p>
		  </blockquote>
		  <label for="notes">Other info</label>
		  <br/>
		  <textarea
			id="notes"
			name="notes"
			rows="4"
			cols="80"
			placeholder="I can offer baked cookies, beer, or some new music recs :)"
		  ></textarea>
		  <br/>
		  <button type="submit">Submit Request</button>
		</form>

		<hr/>

		<h2>Sub Requests</h2>
		<div id="sub-requests-list">
		  if len(subRequests) == 0 {
		  <p>No sub requests yet.</p>
		  } else {
		<table class="data-table">
			<thead>
				<tr>
					<th>When</th>
					<th>Show</th>
					<th>Posted By</th>
					<th>Taken By</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
			for _, req := range subRequests {
				<tr id={ "sub-request-row-" + strconv.Itoa(req.ID) } class={ templ.KV("row-available", req.TakerEmail == ""), templ.KV("row-taken", req.TakerEmail != "") }>
					<td>{ req.StartTime }</td>
					<td>{ req.ShowTitle }</td>
					<td>{ req.RequesterEmail }</td>
					<td>
						if req.TakerEmail != "" {
						{ req.TakerEmail }
						} else {
						—
						}
					</td>
					<td class="actions-cell">
						if req.CanTake {
						<button class="btn-action btn-action-primary" onclick={ templ.ComponentScript{
							Call: "takeRequest('" + strconv.Itoa(req.ID) + "')",
						} }>
							Take
						</button>
						}
						if req.CanUntake {
						<button class="btn-action btn-action-warning" onclick={ templ.ComponentScript{
							Call: "untakeRequest('" + strconv.Itoa(req.ID) + "')",
						} }>
							Untake
						</button>
						}
						if req.CanDelete {
						<button class="btn-action btn-action-danger" onclick={ templ.ComponentScript{
							Call: "deleteRequest('" + strconv.Itoa(req.ID) + "')",
						} }>
							Delete
						</button>
						}
					</td>
				</tr>
			}
			</tbody>
		</table>
		  }
		</div>

		<style>
		  blockquote {
			margin: 1rem 0;
			padding: 0.5rem 1rem;
			border-left: 4px solid #eee;
			background: #fcfcfc;
		  }
		</style>

		<script>
		  const showSelect = document.getElementById("show-select");
		  const previewShow = document.getElementById("selected-show");
		  const startTimeInput = document.getElementById("start-time");
		  const previewDate = document.getElementById("preview-date");
		  const endTimeInput = document.getElementById("end-time");
		  const previewDuration = document.getElementById("total-duration");

		  function updatePreview() {
			// Show
			const selectedOption = showSelect.options[showSelect.selectedIndex];
			if (selectedOption && selectedOption.value) {
			  previewShow.innerHTML = ` for <i>${selectedOption.textContent.trim()}</i>`;
			} else {
			  previewShow.textContent = "";
			}

			// Date
			const startValue = startTimeInput.value;
			if (startValue) {
			  const start = new Date(startValue);
			  if (!isNaN(start)) {
				const options = {
				  weekday: "long",
				  month: "short",
				  day: "numeric",
				  hour: "numeric",
				  minute: "numeric",
				};
				previewDate.textContent = ` on ${start.toLocaleString(undefined, options)}`;
			  } else {
				previewDate.textContent = "";
			  }
			} else {
			  previewDate.textContent = "";
			}

			// Duration
			const endValue = endTimeInput.value;
			if (startValue && endValue) {
			  const start = new Date(startValue);
			  const end = new Date(endValue);
			  if (!isNaN(start) && !isNaN(end)) {
				const diff = end - start;
				if (diff >= 0) {
				  const minutes = Math.floor((diff / (1000 * 60)) % 60);
				  const hours = Math.floor(diff / (1000 * 60 * 60));
				  previewDuration.textContent = ` (${hours}h ${minutes}m)`;
				} else {
				  previewDuration.textContent = "";
				}
			  } else {
				previewDuration.textContent = "";
			  }
			} else {
			  previewDuration.textContent = "";
			}
		  }

		  // Initial min for start-time
		  const now = new Date();
		  const yesterday = new Date(now.getTime() - 24 * 60 * 60 * 1000);
		  const pad = (num) => String(num).padStart(2, "0");
		  const minStartStr = `${yesterday.getFullYear()}-${pad(
			yesterday.getMonth() + 1,
		  )}-${pad(yesterday.getDate())}T${pad(yesterday.getHours())}:${pad(
			yesterday.getMinutes(),
		  )}`;
		  startTimeInput.min = minStartStr;

		  showSelect.addEventListener("change", updatePreview);
		  startTimeInput.addEventListener("input", () => {
			endTimeInput.min = startTimeInput.value;
			updatePreview();
		  });
		  endTimeInput.addEventListener("input", updatePreview);

		  // Run once on load in case browser remembers values
		  updatePreview();

		  async function deleteRequest(id) {
			if (!confirm("Are you sure you want to delete this sub request?")) {
			  return;
			}

			try {
			  const response = await fetch(`/sub-requests/${id}`, {
				method: "DELETE",
			  });

			  if (response.ok) {
				window.location.reload();
			  } else {
				const text = await response.text();
				alert(`Failed to delete request: ${text || response.statusText}`);
			  }
			} catch (error) {
			  console.error("Error deleting request:", error);
			  alert("An error occurred while deleting the request.");
			}
		  }

		  async function takeRequest(id) {
			try {
			  const response = await fetch(`/sub-requests/${id}`, {
				method: "PATCH",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ action: "take" }),
			  });

			  if (response.ok) {
				window.location.reload();
			  } else {
				const text = await response.text();
				alert(`Failed to take request: ${text || response.statusText}`);
			  }
			} catch (error) {
			  console.error("Error taking request:", error);
			  alert("An error occurred while taking the request.");
			}
		  }

		  async function untakeRequest(id) {
			try {
			  const response = await fetch(`/sub-requests/${id}`, {
				method: "PATCH",
				headers: { "Content-Type": "application/json" },
				body: JSON.stringify({ action: "untake" }),
			  });

			  if (response.ok) {
				window.location.reload();
			  } else {
				const text = await response.text();
				alert(`Failed to untake request: ${text || response.statusText}`);
			  }
			} catch (error) {
			  console.error("Error untaking request:", error);
			  alert("An error occurred while untaking the request.");
			}
		  }
		</script>
	}
}
