package ui

import "strconv"

templ Admin(users []UserView, email string) {
	@Layout("Admin Dashboard - Air Cover") {
		@BaseStyles()
		<a href="/app" style="display: inline-block; margin-bottom: 0.5rem; color: #2563eb; text-decoration: none">&larr; Go to sub board</a>
		@PageHeader("Admin Dashboard") {
			@UserMenu(email)
		}

		<hr/>
		<div style="display: flex; justify-content: flex-end; margin-bottom: 1rem">
			<form action="/users/import/spinitron" method="POST" style="margin: 0">
				<button type="submit" style="
					background: #2563eb;
					color: white;
					border: none;
					padding: 0.5rem 1rem;
					border-radius: 4px;
					cursor: pointer;
				  ">
					Import all Spinitron DJs
				</button>
			</form>
		</div>
		<section style="
				margin-bottom: 2rem;
				background: #f0f9ff;
				border: 1px solid #bae6fd;
				border-radius: 8px;
				padding: 0.5rem;
			  ">
			<form action="/users" method="POST">
				<div style="flex: 1; min-width: 200px; margin-bottom: 0.5rem">
					<label for="email">Add a user</label>
					<input type="email" id="email" name="email" required placeholder="dj@example.com" style="
					  width: 100%;
					  padding: 0.5rem;
					  border: 1px solid #ccc;
					  box-sizing: border-box;
					"/>
				</div>
				<button type="submit">Add user</button>
			</form>
		</section>

		<div id="users-list">
			if len(users) == 0 {
			<p>No users found.</p>
			} else {
			<table class="users-table">
				<thead>
					<tr>
						<th>Email</th>
						<th>Role</th>
						<th>Actions</th>
					</tr>
				</thead>
				<tbody>
					for _, user := range users {
					<tr id={ "user-row-" + strconv.Itoa(user.ID) }>
						<td>{ user.Email }</td>
						<td>
							if user.IsEnabled {
							<span class={ "role-badge role-" + user.Role }>{ user.Role }</span>
							}
						</td>
						<td class="user-actions">
							if user.CanDeactivate {
							<button class={ templ.KV("deactivate-button", user.IsEnabled), templ.KV("activate-button", !user.IsEnabled) } onclick={ templ.ComponentScript{Call: "toggleUserStatus(" + strconv.Itoa(user.ID) + ", " + strconv.FormatBool(user.IsEnabled) + ")"} }>
								if user.IsEnabled {
								Deactivate
								} else {
								Reinstate
								}
							</button>
							if user.IsEnabled {
							<button class="role-button" onclick={ templ.ComponentScript{Call: "toggleUserRole(" + strconv.Itoa(user.ID) + ", '" + user.Role + "')"} }>
								if user.Role == "admin" {
								{ "Make Member" }
								} else {
								{ "Make Admin" }
								}
							</button>
							} }
						</td>
					</tr>
					}
				</tbody>
			</table>
			}
		</div>

		<script>
			async function toggleUserStatus(userId, currentIsEnabled) {
				const newStatus = !currentIsEnabled;
				const action = newStatus ? "activate" : "deactivate";
				if (!confirm(`Are you sure you want to ${action} this user?`)) {
					return;
				}

				try {
					const response = await fetch(`/users/${userId}`, {
						method: "PATCH",
						headers: {
							"Content-Type": "application/json",
						},
						body: JSON.stringify({ is_enabled: newStatus }),
					});

					if (response.ok) {
						window.location.reload();
					} else {
						const error = await response.text();
						alert(`Failed to ${action} user: ${error}`);
					}
				} catch (err) {
					console.error("Update failed:", err);
					alert(`Failed to ${action} user due to a network error.`);
				}
			}

			async function toggleUserRole(userId, currentRole) {
				const newRole = currentRole === "admin" ? "member" : "admin";
				const action = newRole === "admin" ? "promote" : "demote";
				if (
					!confirm(
						`Are you sure you want to ${action} this user to ${newRole}?`,
					)
				) {
					return;
				}

				try {
					const response = await fetch(`/users/${userId}`, {
						method: "PATCH",
						headers: {
							"Content-Type": "application/json",
						},
						body: JSON.stringify({ role: newRole }),
					});

					if (response.ok) {
						window.location.reload();
					} else {
						const error = await response.text();
						alert(`Failed to ${action} user: ${error}`);
					}
				} catch (err) {
					console.error("Update failed:", err);
					alert(`Failed to ${action} user due to a network error.`);
				}
			}
		</script>

		<style>
			.users-table {
				width: 100%;
				border-collapse: collapse;
				margin-top: 1rem;
			}

			.users-table th,
			.users-table td {
				text-align: left;
				border-bottom: 1px solid #eee;
				white-space: nowrap;
				display: revert;
			}

			.users-table th {
				background-color: #f9f9f9;
				font-weight: 600;
				border-bottom: 2px solid #ddd;
			}

			.users-table tbody tr {
				height: 1rem;
			}

			.users-table tbody tr:hover {
				background-color: #f5f5f5;
			}

			.user-actions {
				display: flex;
				gap: 0.5rem;
			}

			.role-badge {
				display: inline-block;
				padding: 0.125rem 0.5rem;
				border-radius: 4px;
				font-size: 0.875rem;
				font-weight: 500;
				text-transform: uppercase;
			}

			.role-admin {
				background-color: gold;
				color: black;
			}

			.role-user {
				background-color: #f5f5f5;
				color: #616161;
			}

			.deactivate-button {
				background-color: #fee2e2;
				color: #991b1b;
				border: 1px solid #f87171;
				border-radius: 6px;
				cursor: pointer;
			}

			.deactivate-button:hover {
				background-color: #fecaca;
			}

			.activate-button {
				background-color: #dcfce7;
				color: #166534;
				border: 1px solid #86efac;
				border-radius: 6px;
				cursor: pointer;
			}

			.activate-button:hover {
				background: #dcfce7;
			}

			.role-button {
				background: #6366f1;
				color: white;
				border: none;
				border-radius: 4px;
				cursor: pointer;
			}

			.role-button:hover {
				background: #4f46e5;
			}
		</style>
	}
}